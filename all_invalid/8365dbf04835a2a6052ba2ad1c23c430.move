    // Function to test resource move and abort
    public fun resource_move_abort_test(addr: address) {
        let res = MyResource {counter: 1, data: 42};
        move_resource_and_burn(addr, res);
        // Following line should fail if resource moved successfully
        check_resource_exists(addr);
        // Abort after resource move
        abort ERR_RESOURCE_NOT_FOUND;
    }

    // Function to test just an abort
    public fun abort_in_test() {
        abort ERR_ABORT;
    }

    // Runner to execute the above functions
    public fun run_all_tests(addr: address) {
        let _ = error_divide_with_abort();
        // Expect abort with divide by zero
        // Move resource test
        resource_move_abort_test(addr);
        // Expect abort due to resource move failure
        abort;
        // Aborting test
        abort_in_test();
    }
