module 0xCAFE::ErrorHandlingTest {
    use std::error;
    use std::signer;
    use std::vector;

    // Custom error codes
    const ERR_DIVIDE_BY_ZERO: u64 = 1001;
    const ERR_RESOURCE_NOT_FOUND: u64 = 1002;
    const ERR_ABORT: u64 = 9999;

    struct MyResource has key {
        counter: u64,
        data: u64,
    }

    // Function that intentionally divides by zero to trigger abort
    public fun divide_by_zero(x: u64, y: u64): u64 {
        if (y == 0) {
            abort ERR_DIVIDE_BY_ZERO;
        };
        x / y
    }

    // Function that moves a resource
    public fun move_resource_and_burn(addr: address, r: MyResource) {
        move_to<MyResource>(&signer::borrow_signer(&signer::new_signer(addr)), r);
        // Simulate resource move by removing it
        let _ = move_from<MyResource>(addr);
        // Attempt to move again, should fail
        move_from<MyResource>(addr);
    }

    // Function that aborts intentionally
    public fun abort_in_function() {
        abort ERR_ABORT;
    }

    // Function that checks resource existence
    public fun check_resource_exists(addr: address): bool {
        borrow_global_opt<MyResource>(addr).is_some()
    }

