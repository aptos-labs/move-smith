    module UnitTypes {
        /// This module tests unit types definition and usage,
        /// reference safety, and inline function with closures.

        /// Define unit types using zero-sized structs
        struct Meter has copy, drop, store {}
        struct Second has copy, drop, store {}

        /// Function demonstrating reference safety annotations
        public fun safe_references(m: &Meter, s: &mut Second) {
            // Reference safety with immutable and mutable references
            // This should pass safety checks, no invalid aliasing.
            let _m_borrowed: &Meter = m;
            let _s_borrowed: &mut Second = s;
        }

        /// A function with specific code blocks that have conditions and expressions
        public fun condition_blocks(x: u64): u64 {
            if (x > 10) {
                let y = x * 2;
                y
            } else if (x == 10) {
                let y = x + 5;
                y
            } else {
                let y = 0;
                y
            }
        }

        /// Inline function that accepts a closure with no parameters and returns u64
        public inline fun inline_closure_no_args<F: copy + drop + store>(f: F): u64
            where F: Fn() -> u64
        {
            f()
        }

        /// Inline function that accepts a closure with one u64 parameter and returns u64
        public inline fun inline_closure_one_arg<F: copy + drop + store>(f: F, val: u64): u64
            where F: Fn(u64) -> u64
        {
            f(val)
        }

        /// Runner function to test closures and other features
        public fun run() {
            // Use condition_blocks function
            let c1 = condition_blocks(20);
            let c2 = condition_blocks(10);
            let c3 = condition_blocks(5);

            // Test inline closure no args
            let res1 = inline_closure_no_args(|| 42u64);

            // Test inline closure with one arg
            let res2 = inline_closure_one_arg(|x| x * 3, 7u64);

            // Use safe_references
            let m = Meter {};
            let mut s = Second {};
            safe_references(&m, &mut s);

            // Dummy usage to avoid warnings
            let _ = (c1, c2, c3, res1, res2);
        }
    }
}
//# run 0x1::UnitTypes::run

